        "mainEntity": [
          {
            "@type": "Question",
            "name": "Does a 7.18% national mortgage average determine my home’s value?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. A national mortgage average is financing context. Property-specific pricing requires current competing listings, recent comparable sales, condition and transaction terms."
            }
          },
          {
            "@type": "Question",
            "name": "Does Miami’s historical price growth show that mortgage rates do not matter?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. A long-run house-price index does not measure current rate sensitivity or establish the value of a particular property."
            }
          },
          {
            "@type": "Question",
            "name": "What happens after a Private Seller Strategy Review request?",
            "acceptedAnswer": {
              "@type": "Answer",
